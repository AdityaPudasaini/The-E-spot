CREATE TABLE bidding_house (
    Bidding_House_ID INT(11) PRIMARY KEY AUTO_INCREMENT,
    Product_ID INT(11),
    Start_Price DECIMAL(12,2),
    Reserve_Price DECIMAL(12,2),
    Start_Time DATETIME,
    End_Time DATETIME,
    Bidding_House_Status VARCHAR(30),
    FOREIGN KEY (Product_ID) REFERENCES product(Product_ID)
);