CREATE TABLE wishlist_item (
    Wishlist_Item_ID INT(11) PRIMARY KEY AUTO_INCREMENT,
    Wishlist_ID INT(11),
    Product_ID INT(11),
    Added_Date DATETIME,
    FOREIGN KEY (Wishlist_ID) REFERENCES wishlist(Wishlist_ID),
    FOREIGN KEY (Product_ID) REFERENCES product(Product_ID)
);

INSERT INTO wishlist_item (Wishlist_ID, Product_ID, Added_Date) VALUES (?, ?, NOW());

SELECT Wishlist_Item_ID FROM wishlist_item WHERE Wishlist_ID = ? AND Product_ID = ?;

DELETE FROM wishlist_item WHERE Wishlist_Item_ID = ?;