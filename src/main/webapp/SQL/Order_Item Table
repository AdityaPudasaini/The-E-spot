CREATE TABLE order_item (
    Order_Item_ID INT(11) PRIMARY KEY AUTO_INCREMENT,
    Order_ID INT(11),
    Product_ID INT(11),
    Item_Quantity INT(11),
    Item_Price DECIMAL(12,2),
    FOREIGN KEY (Order_ID) REFERENCES `order`(Order_ID),
    FOREIGN KEY (Product_ID) REFERENCES product(Product_ID)
);

INSERT INTO order_item (Order_ID, Product_ID, Item_Quantity, Item_Price) VALUES (?, ?, ?, ?);

SELECT SUM(Item_Quantity) AS totalSold FROM order_item oi JOIN `order` o ON oi.Order_ID = o.Order_ID WHERE o.Order_Status = 'Completed';

SELECT COALESCE(SUM(oi.Item_Quantity), 0) AS totalBought FROM order_item oi JOIN `order` o ON oi.Order_ID = o.Order_ID WHERE o.Member_ID = ? AND o.Order_Status = 'Completed';